 "tokenColors": [
  {
   "name": "Commentaires",
   "scope": [
    "comment",
    "punctuation.definition.comment",
    "string.comment"
   ],
   "settings": {
    "foreground": "#5f6c88",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Mots-clés",
   "scope": [
    "keyword",
    "storage",
    "storage.type",
    "storage.modifier",
    "keyword.control",
    "keyword.other"
   ],
   "settings": {
    "foreground": "#ff5fa8"
   }
  },
  {
   "name": "Opérateurs",
   "scope": [
    "keyword.operator",
    "punctuation.accessor",
    "punctuation.separator.key-value"
   ],
   "settings": {
    "foreground": "#8fd8ff"
   }
  },
  {
   "name": "Ponctuation",
   "scope": [
    "punctuation",
    "meta.brace",
    "punctuation.definition.block",
    "punctuation.terminator"
   ],
   "settings": {
    "foreground": "#95a0b8"
   }
  },
  {
   "name": "Chaînes",
   "scope": [
    "string",
    "punctuation.definition.string",
    "string.quoted"
   ],
   "settings": {
    "foreground": "#c8f04a"
   }
  },
  {
   "name": "Échappements et expressions régulières",
   "scope": [
    "constant.character.escape",
    "string.regexp",
    "constant.other.placeholder",
    "punctuation.definition.template-expression",
    "punctuation.section.embedded"
   ],
   "settings": {
    "foreground": "#22e0c8"
   }
  },
  {
   "name": "Nombres",
   "scope": [
    "constant.numeric",
    "keyword.other.unit"
   ],
   "settings": {
    "foreground": "#ff9440"
   }
  },
  {
   "name": "Constantes du langage",
   "scope": [
    "constant.language",
    "variable.language",
    "support.constant"
   ],
   "settings": {
    "foreground": "#b58cff"
   }
  },
  {
   "name": "Constantes",
   "scope": [
    "constant",
    "variable.other.constant",
    "variable.other.enummember"
   ],
   "settings": {
    "foreground": "#d0a8ff"
   }
  },
  {
   "name": "Fonctions",
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call",
    "variable.function",
    "meta.function-call.generic"
   ],
   "settings": {
    "foreground": "#2fc4ff"
   }
  },
  {
   "name": "Classes et types",
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "entity.other.inherited-class",
    "entity.name.namespace",
    "storage.type.primitive"
   ],
   "settings": {
    "foreground": "#22e0c8"
   }
  },
  {
   "name": "Variables",
   "scope": [
    "variable",
    "meta.definition.variable",
    "variable.other.readwrite"
   ],
   "settings": {
    "foreground": "#dfe5f2"
   }
  },
  {
   "name": "Paramètres",
   "scope": [
    "variable.parameter",
    "meta.parameter"
   ],
   "settings": {
    "foreground": "#ffb38a",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Propriétés",
   "scope": [
    "variable.other.property",
    "variable.other.object.property",
    "meta.object-literal.key",
    "support.variable.property",
    "support.type.property-name",
    "entity.name.tag.yaml"
   ],
   "settings": {
    "foreground": "#8ab8ff"
   }
  },
  {
   "name": "Décorateurs et annotations",
   "scope": [
    "meta.decorator",
    "entity.name.function.decorator",
    "punctuation.definition.decorator",
    "meta.annotation",
    "storage.type.annotation"
   ],
   "settings": {
    "foreground": "#ffb629"
   }
  },
  {
   "name": "Balises",
   "scope": [
    "entity.name.tag",
    "punctuation.definition.tag"
   ],
   "settings": {
    "foreground": "#ff5fa8"
   }
  },
  {
   "name": "Attributs",
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#ffb629",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Sélecteurs CSS",
   "scope": [
    "entity.other.attribute-name.class.css",
    "entity.other.attribute-name.id.css",
    "entity.name.tag.css"
   ],
   "settings": {
    "foreground": "#22e0c8",
    "fontStyle": ""
   }
  },
  {
   "name": "Propriétés CSS",
   "scope": [
    "support.type.property-name.css",
    "meta.property-name.css"
   ],
   "settings": {
    "foreground": "#8ab8ff"
   }
  },
  {
   "name": "Valeurs CSS",
   "scope": [
    "support.constant.property-value.css",
    "constant.other.color"
   ],
   "settings": {
    "foreground": "#ff9440"
   }
  },
  {
   "name": "Clés JSON",
   "scope": [
    "support.type.property-name.json",
    "meta.structure.dictionary.key.python string"
   ],
   "settings": {
    "foreground": "#8ab8ff"
   }
  },
  {
   "name": "Titres Markdown",
   "scope": [
    "markup.heading",
    "entity.name.section",
    "punctuation.definition.heading"
   ],
   "settings": {
    "foreground": "#fcee0a",
    "fontStyle": "bold"
   }
  },
  {
   "name": "Gras",
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "foreground": "#c8f04a",
    "fontStyle": "bold"
   }
  },
  {
   "name": "Code en ligne",
   "scope": [
    "markup.inline.raw",
    "markup.inline.raw punctuation.definition.raw",
    "markup.bold markup.inline.raw"
   ],
   "settings": {
    "foreground": "#2fc4ff"
   }
  },
  {
   "name": "Italique",
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "foreground": "#b58cff",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Barré",
   "scope": [
    "markup.strikethrough",
    "markup.strikethrough markup.inline.raw",
    "markup.strikethrough string",
    "markup.strikethrough punctuation.definition.raw",
    "markup.strikethrough markup.italic"
   ],
   "settings": {
    "foreground": "#ff2800",
    "fontStyle": "strikethrough"
   }
  },
  {
   "name": "Barré en gras",
   "scope": [
    "markup.strikethrough markup.bold",
    "markup.bold markup.strikethrough",
    "markup.bold markup.strikethrough markup.inline.raw",
    "markup.strikethrough markup.bold markup.inline.raw"
   ],
   "settings": {
    "foreground": "#ff2800",
    "fontStyle": "bold strikethrough"
   }
  },
  {
   "name": "Liens",
   "scope": [
    "markup.underline.link",
    "string.other.link",
    "meta.link"
   ],
   "settings": {
    "foreground": "#2fc4ff"
   }
  },
  {
   "name": "Listes et citations",
   "scope": [
    "punctuation.definition.list.begin",
    "markup.quote",
    "punctuation.definition.quote.begin"
   ],
   "settings": {
    "foreground": "#ff5fa8"
   }
  },
  {
   "name": "Ajouté",
   "scope": [
    "markup.inserted",
    "punctuation.definition.inserted"
   ],
   "settings": {
    "foreground": "#4be38a"
   }
  },
  {
   "name": "Retiré",
   "scope": [
    "markup.deleted",
    "punctuation.definition.deleted"
   ],
   "settings": {
    "foreground": "#ff4d5e"
   }
  },
  {
   "name": "Modifié",
   "scope": [
    "markup.changed",
    "meta.diff.range",
    "meta.diff.header"
   ],
   "settings": {
    "foreground": "#2fc4ff"
   }
  },
  {
   "name": "Invalide",
   "scope": [
    "invalid",
    "invalid.illegal"
   ],
   "settings": {
    "foreground": "#ff4d5e",
    "fontStyle": "underline"
   }
  }
 ],
 "semanticTokenColors": {
  "function": "#2fc4ff",
  "method": "#2fc4ff",
  "class": "#22e0c8",
  "type": "#22e0c8",
  "interface": "#22e0c8",
  "struct": "#22e0c8",
  "enum": "#22e0c8",
  "enumMember": "#d0a8ff",
  "namespace": "#7fe3d6",
  "parameter": {
   "foreground": "#ffb38a",
   "italic": true
  },
  "property": "#8ab8ff",
  "variable": "#dfe5f2",
  "variable.readonly": "#d0a8ff",
  "variable.defaultLibrary": "#b58cff",
  "decorator": "#ffb629",
  "macro": "#ffb629",
  "keyword": "#ff5fa8",
  "number": "#ff9440",
  "string": "#c8f04a",
  "selfParameter": {
   "foreground": "#b58cff",
   "italic": true
  }
 }
}